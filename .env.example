# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Secret BotFather token used exclusively on serverless backend (/api/webhook, /api/set-webhook)
# NEVER commit the real token into git or put it in client code!
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# TELEGRAM_SECRET_TOKEN: Optional secret header token to verify incoming requests from Telegram
TELEGRAM_SECRET_TOKEN="optional_secret_token_here"

# ADMIN_SECRET: Optional secret required to access /api/set-webhook management actions
ADMIN_SECRET="optional_admin_secret_here"

# TELEGRAM_CHANNEL: Target Telegram community channel for broadcasts (defaults to @musicmimi_community)
TELEGRAM_CHANNEL="@musicmimi_community"

# VITE_ADSGRAM_REWARD_BLOCK_ID: Active Adsgram Reward Unit Block ID ($mimi rewards)
VITE_ADSGRAM_REWARD_BLOCK_ID="55577"

# VITE_ADSGRAM_INTERSTITIAL_BLOCK_ID: Active Adsgram Interstitial Unit Block ID ($mimi interstitial)
VITE_ADSGRAM_INTERSTITIAL_BLOCK_ID="int-55578"

# VITE_ADSGRAM_TASK_BLOCK_ID: Active Adsgram Task Unit Block ID ($mimi task)
VITE_ADSGRAM_TASK_BLOCK_ID="task-55579"

# VITE_ADSGRAM_BLOCK_ID: Primary Adsgram Block ID fallback
VITE_ADSGRAM_BLOCK_ID="55577"

# VITE_OWNER_REVENUE_WALLET: TON wallet address receiving Adsgram ad rewards for liquidity
VITE_OWNER_REVENUE_WALLET="UQCq-PboNEs9iF9VaUIGt2PxVuUXcykeq0R0zcBg1nchEXAF"
